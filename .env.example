# ── LLM ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# Model ids auto-verified at startup against /v1/models; leave blank to auto-pick
MODEL_REASON=
MODEL_FAST=
MODEL_EMBED=text-embedding-3-small

# ── Lead discovery ──────────────────────────────────────────────────────
# serper.dev — free tier is plenty
SERPER_API_KEY=
# optional, hunter.io — decision-maker email finding
HUNTER_API_KEY=

# ── Email (live mode) ───────────────────────────────────────────────────
# sim = in-app simulated inbox (zero setup) | live = real SMTP/IMAP (Gmail app password)
EMAIL_MODE=sim
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD=
IMAP_HOST=imap.gmail.com
# HARD SAFETY: live emails only ever go to these addresses (comma-separated).
# Anything else is auto-routed to the simulated inbox — prevents cold-emailing real strangers.
EMAIL_ALLOWLIST=demo.prospect@gmail.com

# ── WhatsApp ────────────────────────────────────────────────────────────
# sim | greenapi | twilio | callmebot
WHATSAPP_MODE=sim
ADMIN_WHATSAPP=+92XXXXXXXXXX
GREENAPI_INSTANCE_ID=
GREENAPI_TOKEN=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WA_FROM=whatsapp:+14155238886
CALLMEBOT_APIKEY=

# ── Meetings ────────────────────────────────────────────────────────────
BOOKING_BASE_URL=http://localhost:8000
MEETING_PROVIDER=jitsi

# ── Demo controls ───────────────────────────────────────────────────────
# Scales all waits: 86400 = real time. 60 = one "day" per minute (demo mode),
# so the 3-day follow-up fires ~3 minutes after outreach.
SECONDS_PER_DAY=60
FOLLOWUP_AFTER_DAYS=3
MEETING_REMINDER_MINUTES=30
